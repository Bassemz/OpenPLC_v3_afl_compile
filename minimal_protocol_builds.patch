+
+int main(int argc, char **argv)
+{
+    uint16_t port = 44818;
+    if (argc >= 2)
+    {
+        long parsed = strtol(argv[1], nullptr, 10);
+        if (parsed > 0 && parsed < 65536)
+        {
+            port = static_cast<uint16_t>(parsed);
+        }
+        else
+        {
+            fprintf(stderr, "Invalid port '%s' (expected 1-65535)\n", argv[1]);
